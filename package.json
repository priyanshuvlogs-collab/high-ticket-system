{
  "name": "bookedai",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "AI meeting-booking agent for high-ticket coaches and consultants (Hustle Buddies)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:api": "pnpm --filter @bookedai/api dev",
    "dev:worker": "pnpm --filter @bookedai/api worker",
    "dev:web": "pnpm --filter @bookedai/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @bookedai/db generate",
    "db:push": "pnpm --filter @bookedai/db push",
    "db:migrate": "pnpm --filter @bookedai/db migrate",
    "seed:demo": "tsx scripts/seed-demo-client.ts",
    "demo:chat": "tsx scripts/demo-chat.ts",
    "twilio:setup": "tsx scripts/twilio-setup.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@bookedai/agent": "workspace:*",
    "@bookedai/db": "workspace:*",
    "@bookedai/integrations": "workspace:*",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.0",
    "twilio": "^5.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}

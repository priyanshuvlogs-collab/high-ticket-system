# ---------- Core ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookedai?schema=public"
ANTHROPIC_API_KEY=""
# Model used for lead conversations. Opus 5.5 is the default; swap to claude-sonnet-5-5 to cut cost.
AGENT_MODEL="claude-opus-5-5"

# ---------- API server ----------
PORT=4000
# Public https URL of the API. Twilio calls this, so it must be reachable from the internet:
# dev: `ngrok http 4000` -> https://xxxx.ngrok-free.app ; prod: your Railway/Fly URL. Required by `pnpm twilio:setup`.
API_PUBLIC_URL="http://localhost:4000"
# Shared secret for dashboard/admin routes (Phase 1 auth). Send as `Authorization: Bearer <token>`.
ADMIN_TOKEN="change-me"
# Allowed origin for the web app
WEB_ORIGIN="http://localhost:3000"

# ---------- Twilio (SMS / WhatsApp) ----------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Set to "false" ONLY in local dev when you post fake webhooks without a Twilio signature.
TWILIO_VALIDATE_SIGNATURE="true"

# ---------- Google Calendar (OAuth2) ----------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/oauth/google/callback"
# If no calendar credentials are configured for a client, the mock calendar is used (demo mode).
CALENDAR_PROVIDER="auto"   # auto | google | mock

# ---------- Jobs ----------
# Optional. If unset, reminders/no-show follow-ups run on an in-process timer (dev only).
REDIS_URL=""

# ---------- Web app ----------
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_DEMO_CLIENT_SLUG="demo-coach"
